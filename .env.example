# NeedThisDone environment template
# The provider-free internal-pilot proof needs only local Supabase and site URLs.

ENV_TARGET=local
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Optional local performance/protection service. The retained app degrades
# safely when Redis is absent; browser assembly tests disable cache access.
REDIS_URL=redis://127.0.0.1:6380

# Optional provider boundaries. Leave blank for provider-free assembly.
OPENAI_API_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
PROSPECTING_SENDER_PROVIDER=disabled
PROSPECTING_RESEND_API_KEY=
RESEND_ADMIN_EMAIL=
RESEND_WEBHOOK_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_OAUTH_STATE_SECRET=
CALENDAR_TOKEN_ENCRYPTION_KEY=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
OPENROUTER_API_KEY=
# Private worker-only model IDs. Keep the primary pinned; use the backup only
# for the approval-gated two-request probe. `openrouter/free` is dynamic and
# must never be selected or pinned as the live worker model.
OPENROUTER_PRIMARY_MODEL=
OPENROUTER_TEST_MODEL=
OPENROUTER_BACKUP_MODEL=

# Optional analyzer/model settings.
NEXT_PUBLIC_CHATBOT_MODEL=gpt-4.1-nano
VECTOR_SEARCH_SIMILARITY_THRESHOLD=0.7
VECTOR_SEARCH_MAX_RESULTS=5

# Development/test controls. Never use OFFLINE_ASSEMBLY_PROOF as an
# authorization bypass; it only disables optional provider enhancement.
SKIP_EMAILS=true
SKIP_CACHE=true
OFFLINE_ASSEMBLY_PROOF=false

# Local-only read-only preview for /dashboard. Ignored in production; never an
# authentication or authorization bypass.
NEXT_PUBLIC_DASHBOARD_PREVIEW=false
