{
  "gateway": {
    "mode": "local",
    "port": 18789,
    "bind": "loopback",
    "controlUi": {
      "enabled": false,
      "sessionObserver": false,
      "automaticallyFetchFavicons": false
    },
    "cliAgents": {
      "enabled": false
    },
    "auth": {
      "mode": "token",
      "token": {
        "source": "env",
        "provider": "default",
        "id": "OPENCLAW_GATEWAY_TOKEN"
      },
      "allowTailscale": false,
      "rateLimit": {
        "maxAttempts": 5,
        "windowMs": 60000,
        "lockoutMs": 300000,
        "exemptLoopback": false
      }
    },
    "tailscale": {
      "mode": "off"
    },
    "reload": {
      "mode": "off"
    },
    "http": {
      "endpoints": {
        "chatCompletions": {
          "enabled": false
        },
        "responses": {
          "enabled": false
        }
      }
    },
    "nodes": {
      "browser": {
        "mode": "off"
      },
      "pairing": {
        "autoApproveLocal": false,
        "sshVerify": false
      },
      "pluginTools": {
        "enabled": false
      },
      "allowSkills": false,
      "commands": {
        "allow": [],
        "deny": []
      }
    },
    "tools": {
      "deny": [
        "*"
      ]
    },
    "allowRealIpFallback": false
  },
  "commands": {
    "restart": false,
    "ownerAllowFrom": []
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "openai/gpt-5.6-luna",
        "fallbacks": []
      },
      "models": {
        "openai/gpt-5.6-luna": {
          "agentRuntime": {
            "id": "openclaw"
          }
        }
      },
      "modelPolicy": {
        "allow": [
          "openai/gpt-5.6-luna"
        ]
      },
      "thinkingDefault": "max",
      "fastModeDefault": false,
      "elevatedDefault": "off",
      "sandbox": {
        "mode": "all",
        "backend": "docker",
        "scope": "session",
        "workspaceAccess": "none",
        "docker": {
          "image": "openclaw-sandbox:bookworm-slim",
          "readOnlyRoot": true,
          "tmpfs": [
            "/tmp",
            "/var/tmp",
            "/run"
          ],
          "network": "none",
          "capDrop": [
            "ALL"
          ],
          "pidsLimit": 64,
          "memory": "512m",
          "memorySwap": "512m",
          "cpus": 1
        }
      },
      "heartbeat": {
        "every": "0m",
        "directPolicy": "block"
      },
      "skills": [],
      "skipBootstrap": true,
      "contextInjection": "never",
      "embeddedAgent": {
        "projectSettingsPolicy": "ignore"
      }
    },
    "entries": {
      "main": {
        "description": "NeedThisDone isolated Luna read-only proof agent"
      }
    }
  },
  "auth": {
    "profiles": {
      "openai:needthisdone-oauth": {
        "provider": "openai",
        "mode": "oauth"
      }
    },
    "order": {
      "openai": [
        "openai:needthisdone-oauth"
      ]
    }
  },
  "tools": {
    "allow": [
      "web_search",
      "web_fetch"
    ],
    "deny": [
      "x_search",
      "browser",
      "canvas",
      "computer",
      "cron",
      "desktop",
      "edit",
      "exec",
      "gateway",
      "secrets",
      "github_publish",
      "image_generate",
      "view_image",
      "message",
      "conversations_send",
      "conversations_turn",
      "nodes",
      "process",
      "publish",
      "read",
      "sessions_send",
      "sessions_spawn",
      "write",
      "apply_patch",
      "group:plugins"
    ],
    "web": {
      "search": {
        "enabled": true,
        "provider": "duckduckgo",
        "maxResults": 5,
        "timeoutSeconds": 30,
        "cacheTtlMinutes": 15
      },
      "fetch": {
        "enabled": true,
        "maxChars": 20000,
        "maxCharsCap": 20000,
        "maxResponseBytes": 750000,
        "timeoutSeconds": 30,
        "cacheTtlMinutes": 15,
        "maxRedirects": 3,
        "useTrustedEnvProxy": false
      }
    },
    "agentToAgent": {
      "enabled": false,
      "allow": []
    },
    "sessions": {
      "visibility": "self"
    },
    "elevated": {
      "enabled": false,
      "allowFrom": {}
    },
    "exec": {
      "mode": "deny",
      "host": "sandbox",
      "strictInlineEval": true,
      "safeBins": [],
      "applyPatch": {
        "enabled": false,
        "workspaceOnly": true,
        "allowModels": []
      }
    },
    "fs": {
      "workspaceOnly": true
    },
    "sandbox": {
      "tools": {
        "allow": [
          "web_search",
          "web_fetch"
        ],
        "deny": [
          "exec",
          "process",
          "code_execution",
          "secrets",
          "read",
          "write",
          "edit",
          "apply_patch",
          "message",
          "conversations_send",
          "conversations_turn",
          "publish",
          "cron",
          "automations",
          "gateway",
          "github_publish",
          "view_image",
          "browser",
          "computer",
          "nodes",
          "sessions_send",
          "sessions_spawn",
          "group:plugins"
        ]
      }
    },
    "updatePlan": false
  },
  "channels": {},
  "cron": {
    "enabled": false,
    "triggers": {
      "enabled": false
    },
    "failureAlert": {
      "enabled": false
    }
  },
  "hooks": {
    "enabled": false,
    "allowRequestSessionKey": false,
    "allowedAgentIds": [],
    "mappings": [],
    "internal": {
      "enabled": false,
      "entries": {}
    }
  },
  "memory": {
    "search": {
      "enabled": false
    }
  },
  "browser": {
    "enabled": false,
    "allowSystemProfileImport": false,
    "evaluateEnabled": false,
    "attachOnly": true,
    "extensionRelay": {
      "allowLegacyAuth": false
    }
  },
  "plugins": {
    "enabled": true,
    "allow": [
      "openai",
      "duckduckgo",
      "web-readability"
    ],
    "deny": [],
    "entries": {
      "duckduckgo": {
        "enabled": true,
        "config": {
          "webSearch": {
            "safeSearch": "moderate"
          }
        }
      }
    }
  },
  "discovery": {
    "mdns": {
      "mode": "off"
    }
  },
  "desktop": {
    "host": {
      "enabled": false
    }
  }
}
