<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.needthisdone.bridge</string>
  <key>ProgramArguments</key><array><string>/bin/bash</string><string>__RUNNER_PATH__</string></array>
  <key>EnvironmentVariables</key><dict><key>BRIDGE_ENV_FILE</key><string>__PRIVATE_ENV_PATH__</string><key>BRIDGE_ENTRYPOINT</key><string>__BRIDGE_ENTRYPOINT__</string><key>NODE_BINARY</key><string>__NODE_BINARY__</string></dict>
  <key>RunAtLoad</key><true/><key>KeepAlive</key><true/>
