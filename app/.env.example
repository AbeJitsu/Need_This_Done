# NeedThisDone application environment template
# Copy to the repository root's private local profile. Keep secrets untracked.

# Local Supabase and application URLs
ENV_TARGET=local
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Provider activation is explicit. Each mode accepts disabled | fake | live.
# Leave modes and credentials blank in examples. A credential alone never
# activates a provider; fake mode additionally requires offline proof below.
TRANSACTIONAL_RESEND_PROVIDER=
PROSPECTING_RESEND_PROVIDER=
CALENDAR_PROVIDER=
STRIPE_INVOICE_PROVIDER=

# Transactional and prospecting Resend lanes are isolated.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_ADMIN_EMAIL=
TRANSACTIONAL_RESEND_WEBHOOK_SECRET=
PROSPECTING_RESEND_API_KEY=
PROSPECTING_RESEND_WEBHOOK_SECRET=

# Calendar OAuth and token encryption stay server-only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_OAUTH_STATE_SECRET=
CALENDAR_TOKEN_ENCRYPTION_KEY=

# Website Fix invoice boundary. Only an sk_test_ key is accepted in live mode.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Application signing and optional local services.
NEXTAUTH_SECRET=
REDIS_URL=
OPENAI_API_KEY=

# The private worker has no selected live model. This exact Gemma model is the
# sole future activation candidate and remains unset until separate approval.
OPENROUTER_API_KEY=
OPENROUTER_PRIMARY_MODEL=
OPENROUTER_TEST_MODEL=
OPENROUTER_BACKUP_MODEL=

# Local proof controls
SKIP_EMAILS=true
SKIP_CACHE=true
OFFLINE_ASSEMBLY_PROOF=false
NEXT_PUBLIC_DASHBOARD_PREVIEW=false
