{
  "name": "fullstack-template-app",
  "version": "1.0.0",
  "description": "Full-stack Next.js application with Supabase and Redis",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack",
    "dev:clean": "rm -rf .next && next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "type-check": "tsc --noEmit",
    "test": "npm run test:e2e",
    "test:a11y": "node scripts/run-a11y-tests.mjs",
    "test:unit": "vitest run --config vitest.unit.config.ts --exclude __tests__/lib/security-hardening.test.ts --exclude __tests__/lib/ai-employee-rls.test.ts --exclude __tests__/lib/retained-schema-manifest.test.ts --exclude __tests__/lib/agent-operations-rls.test.ts --exclude __tests__/lib/agent-planner-rls.test.ts --exclude __tests__/lib/prospecting-rls.test.ts",
    "test:unit:required": "npm run test:unit",
    "test:auth:e2e": "env -u NO_COLOR NODE_ENV=development playwright test e2e/authenticated-employee-workspace.spec.ts --project=auth-contract",
    "test:prospecting-workspace": "env -u NO_COLOR NODE_ENV=development playwright test e2e/prospecting-workspace.spec.ts --project=auth-contract",
    "test:daily-cockpit": "env -u NO_COLOR NODE_ENV=development playwright test e2e/daily-cockpit.spec.ts --project=auth-contract",
    "test:security": "RUN_LOCAL_SUPABASE_TESTS=true vitest run --config vitest.unit.config.ts __tests__/lib/security-hardening.test.ts",
    "test:schema-manifest": "RUN_LOCAL_SUPABASE_TESTS=true vitest run --config vitest.unit.config.ts __tests__/lib/retained-schema-manifest.test.ts",
    "test:ai-employee-rls": "RUN_LOCAL_SUPABASE_TESTS=true vitest run --config vitest.unit.config.ts __tests__/lib/ai-employee-rls.test.ts",
    "test:agent-operations-rls": "RUN_LOCAL_SUPABASE_TESTS=true vitest run --config vitest.unit.config.ts __tests__/lib/agent-operations-rls.test.ts",
    "test:agent-planner-rls": "RUN_LOCAL_SUPABASE_TESTS=true vitest run --config vitest.unit.config.ts __tests__/lib/agent-planner-rls.test.ts",
    "test:prospecting-rls": "RUN_LOCAL_SUPABASE_TESTS=true vitest run --config vitest.unit.config.ts __tests__/lib/prospecting-rls.test.ts",
    "test:consultation-integration": "vitest run --config vitest.integration.config.ts __tests__/api/consultation-persistence.integration.test.ts",
    "test:retained-smoke": "env -u NO_COLOR NODE_ENV=development playwright test e2e/retained-core-smoke.spec.ts e2e/ai-employee-product.spec.ts --project=public --project=public-mobile",
    "test:employee-workspace": "env -u NO_COLOR NODE_ENV=development playwright test e2e/ai-employee-workspace.spec.ts --project=auth-contract",
    "verify:code": "npm run lint && npm run type-check && npm run test:unit:required && npm run test:a11y && npm run build",
    "verify:database": "cd .. && ./scripts/use-env.sh local && supabase db lint --local && cd app && npm run test:schema-manifest && npm run test:security && npm run test:ai-employee-rls && npm run test:agent-operations-rls && npm run test:agent-planner-rls && npm run test:prospecting-rls && npm run test:consultation-integration",
    "verify:assembly": "bash ../scripts/verify-local-assembly.sh",
    "verify:assembly:fresh": "bash ../scripts/verify-local-assembly.sh --fresh",
    "test:all": "npm run verify:assembly",
    "verify:migration-stages": "node ../scripts/verify-hosted-migration-stages.mjs",
    "release:metadata": "node ../scripts/generate-release-metadata.mjs",
    "verify:hosted-migration-step4": "node ../scripts/verify-hosted-migration-step4.mjs",
    "verify:hosted-migration-stage": "node ../scripts/verify-hosted-migration-stage.mjs",
    "verify:hosted-parity": "node ../scripts/verify-hosted-parity.mjs",
    "review:hosted-migration-stage": "node ../scripts/apply-hosted-migration-stage.mjs",
    "apply:hosted-migration-stage": "node ../scripts/apply-hosted-migration-stage.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "supabase:start": "cd .. && supabase start",
    "supabase:stop": "cd .. && supabase stop",
    "supabase:status": "cd .. && supabase status",
    "supabase:reset": "cd .. && supabase db reset",
    "test:emails": "npx tsx scripts/test-emails.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.43",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@react-email/components": "^1.0.12",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "@tailwindcss/typography": "^0.5.20",
    "ai": "^7.0.68",
    "cheerio": "^1.2.0",
    "dompurify": "^3.4.14",
    "framer-motion": "^12.26.2",
    "graphql": "^16.14.2",
    "graphql-yoga": "^5.22.0",
    "highlight.js": "^11.12.0",
    "lucide-react": "^0.562.0",
    "nanoid": "^3.3.18",
    "next": "^16.3.1",
    "next-auth": "^4.24.15",
    "re-resizable": "^6.11.2",
    "react": "^19.3.0-canary-cbb046ab-20260731",
    "react-dom": "^19.3.0-canary-cbb046ab-20260731",
    "react-markdown": "^10.1.0",
    "redis": "^4.6.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "resend": "^3.0.0",
    "server-only": "0.0.1",
    "stripe": "^20.4.1",
    "svix": "^1.82.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@axe-core/react": "^4.11.0",
    "@playwright/test": "^1.57.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/dompurify": "^3.0.5",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.16.0",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.0.13",
    "autoprefixer": "^10.4.0",
    "axe-core": "^4.11.0",
    "axe-playwright": "^2.2.2",
    "dotenv": "^16.6.1",
    "eslint": "^8.55.0",
    "eslint-config-next": "^14.0.0",
    "jest-axe": "^10.0.0",
    "jsdom": "^29.1.1",
    "msw": "^2.12.2",
    "pg": "^8.18.0",
    "playwright": "^1.57.0",
    "postcss": "^8.5.8",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.21.0",
    "typescript": "^5.3.0",
    "vite": "^7.2.6",
    "vitest": "^4.0.13"
  }
}
