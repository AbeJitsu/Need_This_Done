{
  "extends": "./tsconfig.json",
  "include": [
    "next-env.playwright.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next-playwright/types/**/*.ts",
    ".next-playwright/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "next-env.d.ts",
    "__tests__",
    "e2e",
    "scripts",
